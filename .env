###############################################
#   DEFAULT CURRENCY                          #
#   Used when SMS text doesn't specify one    #
#   Options: INR, GBP, USD, EUR, AED, etc.   #
###############################################
DEFAULT_CURRENCY=INR

###############################################
#   PROVIDER 4: Ollama Cloud                  #
#   Remote Ollama-compatible endpoint         #
###############################################
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_MODEL=gpt-oss:120b-cloud
OLLAMA_CLOUD_API_KEY=<your-ollama-cloud-api-key>
## Local Ollama HTTP endpoint (used by the Streamlit app)
# Example: http://localhost:11434
OLLAMA_API=http://localhost:11434
OLLAMA_LOCAL_MODEL=gpt-oss:120b-cloud
OLLAMA_LOCAL_MODEL=llama3.2:latest